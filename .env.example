# ClearSky Intelligence - Environment Configuration
# Quantified Minds (Ishaan Chaturvedi, Ankit Kumar Tiwari)

# Server & Runtime
ENVIRONMENT=development
PORT=8000
HOST=0.0.0.0
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Storage Selection ('sqlite' for local dev, 'dynamodb' for AWS)
STORAGE_BACKEND=sqlite
SQLITE_DB_PATH=data/clearsky.db

# Ingestion / API Rate Limits & Timeouts
API_TIMEOUT_SECONDS=10
CACHE_TTL_MINUTES=30
STALE_THRESHOLD_HOURS=3

# External Data Sources
# OpenAQ API v3 (Optional, register at https://openaq.org)
OPENAQ_API_KEY=your_openaq_api_key_here
OPENAQ_BASE_URL=https://api.openaq.org/v3

# Open-Meteo (No key required for non-commercial evaluation)
OPEN_METEO_FORECAST_URL=https://api.open-meteo.com/v1/forecast
OPEN_METEO_AIR_QUALITY_URL=https://air-quality-api.open-meteo.com/v1/air-quality

# NASA FIRMS (Active Fire Detections, register at https://firms.modaps.eosdis.nasa.gov/api/map_key)
NASA_FIRMS_MAP_KEY=your_nasa_firms_map_key_here
NASA_FIRMS_BASE_URL=https://firms.modaps.eosdis.nasa.gov/api/country/csv

OVERPASS_API_URL=https://overpass-api.de/api/interpreter
 
# Optional Map Tile Key (CARTO Basemaps - https://carto.com/basemaps/apikey)
# If left blank, clean watermark-free OpenStreetMap is used automatically
VITE_CARTO_API_KEY=your_carto_api_key_here

# Admin Security
ADMIN_API_KEY=clearsky-dev-admin-secret-2025

# Baseline Assumptions for Water Efficiency Analytics
DEFAULT_BASELINE_INTERVENTIONS_PER_ZONE_PER_DAY=3.0
DEFAULT_ASSUMED_LITERS_PER_INTERVENTION=5000.0

# Optional Amazon Bedrock / GenAI Summary
ENABLE_AI_BRIEF=false
AWS_REGION=us-east-1
BEDROCK_MODEL_ID=anthropic.claude-3-haiku-20240307-v1:0
