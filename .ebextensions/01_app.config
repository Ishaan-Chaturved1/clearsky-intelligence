option_settings:
  aws:elasticbeanstalk:application:environment:
    PYTHONPATH: "/var/app/current:/var/app/current/backend"
    ENVIRONMENT: "production"
    STORAGE_BACKEND: "dynamodb"
    AWS_REGION: "us-east-1"
    PORT: "5000"
    DYNAMODB_ZONES_TABLE: "clearsky-zones-production"
    DYNAMODB_READINGS_TABLE: "clearsky-readings-production"
    DYNAMODB_DECISIONS_TABLE: "clearsky-decisions-production"
    DYNAMODB_ALERTS_TABLE: "clearsky-alerts-production"
    DYNAMODB_EVENTS_TABLE: "clearsky-events-production"
    DYNAMODB_INVESTIGATIONS_TABLE: "clearsky-investigations-production"
    DYNAMODB_REPORTS_TABLE: "clearsky-citizen-reports-production"
    DYNAMODB_REWARDS_TABLE: "clearsky-rewards-production"
    DYNAMODB_REDEMPTIONS_TABLE: "clearsky-redemptions-production"
    SECRETS_MANAGER_SECRET_NAME: "clearsky/production/api-keys"
  aws:elasticbeanstalk:environment:process:default:
    Port: "5000"
    Protocol: "HTTP"
    HealthCheckPath: "/api/health"
    MatcherHTTPCode: "200"
